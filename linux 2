# Bölüm başlığı yazdıran fonksiyon
baslik_yaz() {
    echo ""
    echo "======================================"
    echo "$1"
    echo "======================================"
}

# ==============================================================================
# GÖREV 1 - ARGÜMAN KONTROLÜ
# ==============================================================================

baslik_yaz "GÖREV 1: Argüman Kontrolü"

# Argüman girilmiş mi kontrol edilir
if [ -z "$1" ]; then
    echo "Hata: Bir dizin yolu belirtilmedi!"
    echo "Kullanım: $0 <dizin_yolu>"
    exit 1
fi

# İlk argüman değişkene atanır
RAPOR_YOLU="$1"

# Dizin mevcut mu kontrol edilir
if [ ! -d "$RAPOR_YOLU" ]; then
    echo "Hata: Belirtilen dizin mevcut değil!"
    exit 1
fi

echo "Argüman kontrolü başarılı."
echo "Hedef dizin: $RAPOR_YOLU"

# ==============================================================================
# GÖREV 2 - ÇALIŞMA DİZİNİ HAZIRLAMA
# ==============================================================================

baslik_yaz "GÖREV 2: Çalışma Dizini Hazırlama"

# Çalışma dizini tanımlanır
CALISMA_ALANI="$HOME/surec_rapor"

# Dizinin eski hali varsa silinir
if [ -d "$CALISMA_ALANI" ]; then
    echo "Eski çalışma dizini siliniyor..."
    rm -rf "$CALISMA_ALANI"
fi

# Yeni çalışma dizini oluşturulur
mkdir -p "$CALISMA_ALANI"

echo "Yeni çalışma dizini oluşturuldu:"
echo "$CALISMA_ALANI"

# ==============================================================================
# BİLGİLENDİRME
# ==============================================================================

echo ""
echo "İlk iki görev başarıyla tamamlandı."
